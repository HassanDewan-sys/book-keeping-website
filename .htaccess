# Bindwell Press - Apache Configuration for Hostinger / Shared Hosting

# Default Directory Index
DirectoryIndex index.php index.html

# Prevent Directory Browsing
Options -Indexes

# Follow Symbolic Links
Options +FollowSymLinks

# Security: Block sensitive files and directories
<FilesMatch "(\.sqlite|\.db|\.env|\.git|\.md|\.log|config\.php)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Protect data and config directories
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block direct access to data folder
    RewriteRule ^data/ - [F,L]

    # Ensure HTTPS (uncomment if SSL is active on Hostinger)
    # RewriteCond %{HTTPS} !=on
    # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# Proper MIME Types
<IfModule mod_mime.c>
    AddType image/webp .webp
    AddType image/svg+xml .svg .svgz
    AddType video/mp4 .mp4
    AddType font/woff2 .woff2
    AddType font/woff .woff
</IfModule>

# Browser Caching
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType video/mp4 "access plus 1 year"
</IfModule>

# Gzip Compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json image/svg+xml
</IfModule>
