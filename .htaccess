# Bindwell Press - Apache Hardened Security Configuration

# Default Directory Index
DirectoryIndex index.php index.html

# Prevent Directory Browsing & Code Listing
Options -Indexes -MultiViews
Options +FollowSymLinks

# ----------------------------------------------------------------------
# 1. Anti-Scraper, Anti-HTTrack & Bot Firewall
# ----------------------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block Bad Bots, Scrapers & Offline Downloaders (HTTrack, Teleport, Wget, WebCopier, etc.)
    RewriteCond %{HTTP_USER_AGENT} (httrack|teleport|webcopier|offline\s*explorer|webzip|sitesnagger|site-snagger|grafula|blackwidow|stripper|sucker|ninja|clshttp|autohttp|extractorpro|pavuk|joc\s*web\s*spider|chinaclaw|custo|disco|go!zilla|grabnet|superbot|zeus|eirgrabber|emailcollector|emailsiphon|emailwolf|harvest|pagegrabber|nikto|sqlmap|acunetix|havij|dirbuster|python-requests|libwww-perl|urllib) [NC,OR]
    RewriteCond %{HTTP_USER_AGENT} ^$ [OR]
    RewriteCond %{HTTP_USER_AGENT} (<|>|%3C|%3E) [NC]
    RewriteRule ^.* - [F,L]

    # Block direct HTTP access to internal code directories
    RewriteRule ^(components|config|data|includes)/ - [F,L]

    # Block direct access to sensitive file extensions
    RewriteRule \.(sqlite|db|env|git|md|log|bak|tmp|swp|json|yml|yaml|ini|sql)$ - [F,L]
</IfModule>

# Security: Block sensitive files by FileMatch
<FilesMatch "(\.sqlite|\.db|\.env|\.git|\.md|\.log|config\.php|\.json|\.yml|\.yaml|\.ini)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# ----------------------------------------------------------------------
# 2. Security Headers (Clickjacking, MIME sniffing, XSS)
# ----------------------------------------------------------------------
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# ----------------------------------------------------------------------
# 3. Proper MIME Types
# ----------------------------------------------------------------------
<IfModule mod_mime.c>
    AddType image/webp .webp
    AddType image/svg+xml .svg .svgz
    AddType video/mp4 .mp4
    AddType font/woff2 .woff2
    AddType font/woff .woff
</IfModule>

# ----------------------------------------------------------------------
# 4. Browser Caching
# ----------------------------------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType video/mp4 "access plus 1 year"
</IfModule>

# ----------------------------------------------------------------------
# 5. Gzip Compression
# ----------------------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json image/svg+xml
</IfModule>
